# ==============================================================================
# LOTEW INDUSTRIAL BACKEND CONFIGURATION (.env.example)
# Copy this file to .env and insert your real project credentials
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://127.0.0.1:3000,*

# Supabase API & Project Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_KEY=<your-service-role-key>
SUPABASE_SECRET_KEY=<your-secret-key>

# Storage Tiering Configuration
STORAGE_BUCKET=industrial-raw
LOCAL_STORAGE_DIR=storage/industrial-raw

# Time Synchronization (Physical Anchor Epoch)
ANCHOR_EPOCH=2024-01-01T00:00:00.000Z
CYCLE_DURATION_SECONDS=60
TOTAL_AVAILABLE_CYCLES=2205

# Raw Hydraulic Dataset Directory
HYDRAULIC_DATA_DIR=data/hydraulic
